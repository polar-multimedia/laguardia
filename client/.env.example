# ── Variables de entorno del cliente (Vite) ──────────────────
# En desarrollo estas variables no son necesarias (Vite proxea /api y /pdf a localhost:3001)
# En producción (Vercel) hay que configurarlas en el dashboard de Vercel

# URL base del backend en Railway (sin barra final)
# Ejemplo: https://clara-server.up.railway.app
VITE_API_URL=

# URL del WebSocket en Railway (Vercel no proxea WS, conecta directo a Railway)
# Ejemplo: wss://clara-server.up.railway.app/api/realtime
VITE_WS_URL=
